    "מוצרים דיגיטליים"
  ],
  "productRules": [
    {
      "match": [
        "קורס"
      ],
      "channel": "קורסים"
    },
    {
      "match": [
        "מנוי"
      ],
      "channel": "מנויים"
    },
    {
      "match": [
        "ייעוץ"
      ],
      "channel": "ייעוץ"
    },
    {
      "match": [
        "ספר"
      ],
