        "יעוץ ארגוני"
      ],
      "channel": "ייעוץ"
    },
    {
      "match": [
        "משרד אדריכלות",
        "צילום אירועים"
      ],
      "channel": "קורסים"
    },
    {
      "match": [
        "בית קפה"
      ],
      "channel": "מנויים"
    }
  ],
